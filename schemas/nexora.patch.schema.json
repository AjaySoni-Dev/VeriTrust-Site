{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.ai/schemas/nexora.patch.schema.json",
  "title": "Nexora Web Project Patch",
  "description": "Transactional revision format applied to an existing nexora.web-project. Fine-grained operations are preferred; page.replace is reserved for structural edits.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "operations",
    "baseRevision"
  ],
  "properties": {
    "schema": {
      "const": "nexora.patch"
    },
    "version": {
      "const": "1.0.0"
    },
    "baseRevision": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,159}$"
    },
    "operation": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "project.update",
            "seo.update",
            "text.set",
            "attribute.set",
            "attribute.unset",
            "class.add",
            "class.remove",
            "style.set",
            "style.unset",
            "style.merge",
            "responsive.merge",
            "style.rule.upsert",
            "style.rule.remove",
            "motion.set",
            "node.move",
            "token.set",
            "token.unset",
            "state.upsert",
            "state.remove",
            "interaction.upsert",
            "interaction.remove",
            "route.upsert",
            "route.remove",
            "page.replace",
            "page.remove",
            "component.upsert",
            "component.remove",
            "asset.upsert",
            "asset.remove",
            "scripts.set",
            "styles.set",
            "function.upsert",
            "function.remove"
          ]
        },
        "pageId": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "toParentId": {
          "$ref": "#/$defs/id"
        },
        "toIndex": {
          "type": "integer",
          "minimum": 0
        },
        "property": {
          "type": "string"
        },
        "value": {},
        "values": {
          "type": "object"
        },
        "declarations": {
          "type": "object"
        },
        "conditionId": {
          "$ref": "#/$defs/id"
        },
        "rule": {
          "type": "object"
        },
        "ruleId": {
          "$ref": "#/$defs/id"
        },
        "motion": {
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "className": {
          "type": "string"
        },
        "tokenId": {
          "type": "string"
        },
        "stateId": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "type": "object"
        },
        "interactionId": {
          "$ref": "#/$defs/id"
        },
        "interaction": {
          "type": "object"
        },
        "routeId": {
          "$ref": "#/$defs/id"
        },
        "route": {
          "type": "object"
        },
        "page": {
          "type": "object"
        },
        "componentId": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "type": "object"
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "asset": {
          "type": "object"
        },
        "scripts": {
          "type": "object"
        },
        "styles": {
          "type": "object"
        },
        "function": {
          "type": "object"
        },
        "functionId": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    }
  }
}
