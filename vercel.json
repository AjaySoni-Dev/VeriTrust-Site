{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/detection.js": {
      "maxDuration": 300
    },
    "api/gateway.js": {
      "maxDuration": 300
    },
    "api/v1.js": {
      "maxDuration": 300
    },
    "api/account.js": {
      "maxDuration": 60
    },
    "api/billing.js": {
      "maxDuration": 60
    },
    "api/system.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/deepfake.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/deepfake",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/gateway-worker",
      "destination": "/api/gateway?resource=worker"
    },
    {
      "source": "/api/deepfake",
      "destination": "/api/detection?route=deepfake"
    },
    {
      "source": "/api/phishing",
      "destination": "/api/detection?route=phishing"
    },
    {
      "source": "/api/link-check",
      "destination": "/api/detection?route=link-check"
    },
    {
      "source": "/api/session",
      "destination": "/api/account?route=session"
    },
    {
      "source": "/api/scans",
      "destination": "/api/account?route=scans"
    },
    {
      "source": "/api/dashboard",
      "destination": "/api/account?route=dashboard"
    },
    {
      "source": "/api/api-keys",
      "destination": "/api/account?route=api-keys"
    },
    {
      "source": "/api/health",
      "destination": "/api/system?route=health"
    },
    {
      "source": "/api/client-config",
      "destination": "/api/system?route=client-config"
    },
    {
      "source": "/api/v1/gateway/policies/:id/activate",
      "destination": "/api/gateway?resource=policies&id=:id&action=activate"
    },
    {
      "source": "/api/v1/gateway/policies",
      "destination": "/api/gateway?resource=policies"
    },
    {
      "source": "/api/v1/gateway/webhooks/:id/disable",
      "destination": "/api/gateway?resource=webhooks&id=:id&action=disable"
    },
    {
      "source": "/api/v1/gateway/webhooks/:id/test",
      "destination": "/api/gateway?resource=webhooks&id=:id&action=test"
    },
    {
      "source": "/api/v1/gateway/webhooks",
      "destination": "/api/gateway?resource=webhooks"
    },
    {
      "source": "/api/v1/gateway/reviews/:id/resolve",
      "destination": "/api/gateway?resource=reviews&id=:id&action=resolve"
    },
    {
      "source": "/api/v1/gateway/reviews",
      "destination": "/api/gateway?resource=reviews"
    },
    {
      "source": "/api/v1/gateway/operations",
      "destination": "/api/gateway?resource=operations"
    },
    {
      "source": "/api/v1/gateway/uploads/:id/complete",
      "destination": "/api/gateway?resource=uploads&id=:id&action=complete"
    },
    {
      "source": "/api/v1/gateway/uploads",
      "destination": "/api/gateway?resource=uploads"
    },
    {
      "source": "/api/v1/gateway/scans/:id/cancel",
      "destination": "/api/gateway?resource=scans&id=:id&action=cancel"
    },
    {
      "source": "/api/v1/gateway/scans/:id",
      "destination": "/api/gateway?resource=scans&id=:id"
    },
    {
      "source": "/api/v1/gateway/scans",
      "destination": "/api/gateway?resource=scans"
    },
    {
      "source": "/api/v1/gateway/reports/:id",
      "destination": "/api/gateway?resource=reports&id=:id"
    },
    {
      "source": "/api/v1/deepfake",
      "destination": "/api/v1?route=deepfake"
    },
    {
      "source": "/api/v1/phishing",
      "destination": "/api/v1?route=phishing"
    },
    {
      "source": "/api/v1/link-check",
      "destination": "/api/v1?route=link-check"
    },
    {
      "source": "/api/v1/usage",
      "destination": "/api/v1?route=usage"
    },
    {
      "source": "/api/billing/checkout",
      "destination": "/api/billing?route=checkout"
    },
    {
      "source": "/api/billing/portal",
      "destination": "/api/billing?route=portal"
    },
    {
      "source": "/api/billing/subscription",
      "destination": "/api/billing?route=subscription"
    },
    {
      "source": "/api/billing/webhook",
      "destination": "/api/billing?route=webhook"
    },
    {
      "source": "/detection",
      "destination": "/detection.html"
    },
    {
      "source": "/gateway",
      "destination": "/gateway.html"
    },
    {
      "source": "/deepfake",
      "destination": "/deepfake.html"
    },
    {
      "source": "/phishing",
      "destination": "/phishing.html"
    },
    {
      "source": "/link-check",
      "destination": "/link-check.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/scans",
      "destination": "/scans.html"
    },
    {
      "source": "/api-access",
      "destination": "/api-access.html"
    },
    {
      "source": "/billing",
      "destination": "/billing.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/auth",
      "destination": "/auth.html"
    },
    {
      "source": "/model-performance",
      "destination": "/model-performance.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/developers",
      "destination": "/developers.html"
    }
  ]
}
