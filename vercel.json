{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/deepfake.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/deepfake",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp-report"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/auth.html", "destination": "/auth", "permanent": true },
    { "source": "/dashboard.html", "destination": "/dashboard", "permanent": true },
    { "source": "/detection.html", "destination": "/detection", "permanent": true },
    { "source": "/deepfake.html", "destination": "/deepfake", "permanent": true },
    { "source": "/phishing.html", "destination": "/phishing", "permanent": true },
    { "source": "/link-check.html", "destination": "/link-check", "permanent": true },
    { "source": "/docs.html", "destination": "/docs", "permanent": true },
    { "source": "/developers.html", "destination": "/developers", "permanent": true },
    { "source": "/model-performance.html", "destination": "/model-performance", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/security.html", "destination": "/security", "permanent": true },
    { "source": "/disclaimer.html", "destination": "/disclaimer", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/health/live",
      "destination": "/api/health"
    },
    {
      "source": "/health/ready",
      "destination": "/api/ready"
    },
    {
      "source": "/api/v1/deepfake",
      "destination": "/api/v1?route=deepfake"
    },
    {
      "source": "/api/v1/phishing",
      "destination": "/api/v1?route=phishing"
    },
    {
      "source": "/api/v1/link-check",
      "destination": "/api/v1?route=link-check"
    },
    {
      "source": "/api/v1/usage",
      "destination": "/api/v1?route=usage"
    },
    {
      "source": "/api/billing/checkout",
      "destination": "/api/billing?route=checkout"
    },
    {
      "source": "/api/billing/portal",
      "destination": "/api/billing?route=portal"
    },
    {
      "source": "/api/billing/subscription",
      "destination": "/api/billing?route=subscription"
    },
    {
      "source": "/api/billing/webhook",
      "destination": "/api/billing?route=webhook"
    },
    {
      "source": "/detection",
      "destination": "/detection.html"
    },
    {
      "source": "/deepfake",
      "destination": "/deepfake.html"
    },
    {
      "source": "/phishing",
      "destination": "/phishing.html"
    },
    {
      "source": "/link-check",
      "destination": "/link-check.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/auth",
      "destination": "/auth.html"
    },
    {
      "source": "/model-performance",
      "destination": "/model-performance.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/developers",
      "destination": "/developers.html"
    }
  ]
}
