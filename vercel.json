{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/detection.js": {
      "maxDuration": 300
    },
    "api/gateway.js": {
      "maxDuration": 300
    },
    "api/v1.js": {
      "maxDuration": 300
    },
    "api/account.js": {
      "maxDuration": 60
    },
    "api/billing.js": {
      "maxDuration": 60
    },
    "api/system.js": {
      "maxDuration": 60
    },
    "api/learning.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/favicon(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/deepfake.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/deepfake",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-NxF1MD3j89FDVujFES5VEXOVpX49NF05bNxWLGnteD8='; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://ajaysoni-dev-deepfakefusion.hf.space; media-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co https://ajaysoni-dev-deepfakefusion.hf.space; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/lib/(.*)",
      "destination": "/api/system?route=not-found"
    },
    {
      "source": "/docs/(.*)",
      "destination": "/api/system?route=not-found"
    },
    {
      "source": "/scripts/(.*)",
      "destination": "/api/system?route=not-found"
    },
    {
      "source": "/test/(.*)",
      "destination": "/api/system?route=not-found"
    },
    {
      "source": "/worker/(.*)",
      "destination": "/api/system?route=not-found"
    },
    {
      "source": "/legacy-php/(.*)",
      "destination": "/api/system?route=not-found"
    },
    {
      "source": "/api/_(.*)",
      "destination": "/api/system?route=not-found"
    },
    {
      "source": "/api/learning-access",
      "destination": "/api/system?route=learning-access"
    },
    {
      "source": "/api/learning/verify/:code",
      "destination": "/api/learning?resource=verify&code=:code"
    },
    {
      "source": "/api/learning/courses/:slug",
