-- Run only after replacing both placeholders outside source control.
-- This file is intentionally not an automatic migration.

begin;

do $configure_gateway$
declare
  worker_url text := 'REPLACE_WITH_GATEWAY_WORKER_URL';
  dispatch_secret text := 'REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES';
  existing_worker_secret uuid;
  existing_dispatch_secret uuid;
begin
  if worker_url like 'REPLACE_WITH_%'
     or dispatch_secret like 'REPLACE_WITH_%'
     or octet_length(dispatch_secret) < 32 then
    raise exception 'Replace the runtime placeholders before executing this script.';
  end if;

  select id into existing_worker_secret
  from vault.secrets
  where name = 'veritrust_gateway_worker_url'
  order by updated_at desc
  limit 1;

  if existing_worker_secret is null then
    perform vault.create_secret(worker_url, 'veritrust_gateway_worker_url', 'Canonical VeriTrust gateway worker endpoint');
  else
    perform vault.update_secret(existing_worker_secret, worker_url, 'veritrust_gateway_worker_url', 'Canonical VeriTrust gateway worker endpoint');
  end if;

  select id into existing_dispatch_secret
  from vault.secrets
  where name = 'veritrust_gateway_dispatch_secret'
  order by updated_at desc
  limit 1;

  if existing_dispatch_secret is null then
    perform vault.create_secret(dispatch_secret, 'veritrust_gateway_dispatch_secret', 'HMAC secret shared with the VeriTrust gateway worker');
  else
    perform vault.update_secret(existing_dispatch_secret, dispatch_secret, 'veritrust_gateway_dispatch_secret', 'HMAC secret shared with the VeriTrust gateway worker');
  end if;
end
$configure_gateway$;

select cron.unschedule(jobid)
from cron.job
where jobname = 'veritrust-gateway-recovery';

select cron.schedule(
  'veritrust-gateway-recovery',
  '* * * * *',
  $command$select veritrust_private.gateway_dispatch_worker('cron');$command$
);

commit;
