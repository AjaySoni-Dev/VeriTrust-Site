{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.ai/schemas/nexora.web-project.schema.json",
  "title": "Nexora Web Project",
  "description": "Canonical Nexora website AST/IR and editable source of truth. It represents atomic semantic nodes, arbitrary standards-based CSS, design tokens, responsive/container/support/layer conditions, reusable motion effects/timelines, state, interactions, data bindings, assets and controlled custom code. HTML/CSS/JavaScript are deterministic compiler outputs, not persistence input.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "project",
    "pages"
  ],
  "properties": {
    "schema": {
      "const": "nexora.web-project"
    },
    "version": {
      "const": "1.0.0"
    },
    "project": {
      "$ref": "#/$defs/projectMeta"
    },
    "intent": {
      "type": "object"
    },
    "settings": {
      "type": "object"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string",
          "number",
          "object",
          "array",
          "null"
        ]
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/condition"
      }
    },
    "tokens": {
      "type": "object"
    },
    "routes": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/route"
          }
        }
      ]
    },
    "assets": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/asset"
          }
        }
      ]
    },
    "components": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/component"
          }
        }
      ]
    },
    "pages": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/page"
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/page"
          }
        }
      ]
    },
    "styles": {
      "$ref": "#/$defs/globalStyles"
    },
    "motion": {
      "$ref": "#/$defs/motionLibrary"
    },
    "logic": {
      "$ref": "#/$defs/logic"
    },
    "data": {
      "type": "object"
    },
    "i18n": {
      "type": "object"
    },
    "scripts": {
      "$ref": "#/$defs/scripts"
    },
    "editor": {
      "type": "object"
    },
    "compiler": {
      "$ref": "#/$defs/compiler"
    },
    "modules": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "authoringProfile": {
      "type": "string",
      "description": "Optional AI authoring profile marker. Current runtime contract is recursive-ai-v3-atomic; canonical normalized storage does not require this marker."
    }
  },
  "unevaluatedProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,159}$"
    },
    "projectMeta": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "generator": {
          "type": "object"
        },
        "compatibility": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "condition": {
      "type": "object",
      "required": [
        "type",
        "query"
      ],
      "properties": {
        "type": {
          "enum": [
            "media",
            "supports",
            "container",
            "layer"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "route": {
      "type": "object",
      "required": [
        "id",
        "pageId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string"
        },
        "pageId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "seo": {
          "type": "object"
        },
        "redirectTo": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "alt": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "cssDeclarations": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        ]
      }
    },
    "styleRule": {
      "type": "object",
      "required": [
        "selector",
        "declarations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "conditionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declarations": {
          "$ref": "#/$defs/cssDeclarations"
        },
        "order": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "style": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/cssDeclarations"
        },
        "responsive": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cssDeclarations"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/styleRule"
          }
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cssDeclarations"
          }
        }
      },
      "additionalProperties": true
    },
    "enterMotion": {
      "type": "object",
      "properties": {
        "preset": {
          "$ref": "#/$defs/id"
        },
        "trigger": {
          "enum": [
            "load",
            "in-view"
          ]
        },
        "duration": {
          "type": "string"
        },
        "delay": {
          "type": "string"
        },
        "easing": {
          "type": "string"
        },
        "iterationCount": {
          "type": [
            "string",
            "number"
          ]
        },
        "fillMode": {
          "type": "string"
        },
        "once": {
          "type": "boolean"
        },
        "keyframes": {
          "$ref": "#/$defs/motionKeyframes"
        },
        "direction": {
          "enum": [
            "normal",
            "reverse",
            "alternate",
            "alternate-reverse"
          ]
        }
      },
      "additionalProperties": true,
      "description": "Editable entrance motion. Built-in presets include fade_in, fade_out, fade_up, fade_down, slide_left, slide_right, zoom_in, flip_3d, tilt_in_3d, and rise_3d; custom keyframes may also be supplied."
    },
    "motion": {
      "type": "object",
      "properties": {
        "enter": {
          "$ref": "#/$defs/enterMotion"
        },
        "hover": {
          "type": "object",
          "properties": {
            "transition": {
              "type": "string"
            },
            "declarations": {
              "$ref": "#/$defs/cssDeclarations"
            }
          },
          "additionalProperties": true
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/motionEffect"
          }
        },
        "timelineIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "reducedMotion": {
          "enum": [
            "skip",
            "final-frame",
            "allow"
          ]
        }
      },
      "additionalProperties": true,
      "description": "Editable structured motion. enter/hover cover common CSS effects; effects provide arbitrary WAAPI-compatible keyframes and load/in-view/hover/focus/click/custom/scroll/view triggers; timelineIds reference reusable project timelines."
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "labelledBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "describedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "tabIndex": {
          "type": [
            "integer",
            "null"
          ]
        },
        "aria": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "binding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "type": "object",
          "properties": {
            "nodeId": {
              "$ref": "#/$defs/id"
            },
            "property": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "path": {
          "type": "string"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        }
      },
      "additionalProperties": true
    },
    "expression": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "literal",
            "path",
            "not",
            "logical",
            "binary"
          ]
        },
        "value": {},
        "path": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "argument": {
          "$ref": "#/$defs/expression"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "left": {
          "$ref": "#/$defs/expression"
        },
        "right": {
          "$ref": "#/$defs/expression"
        }
      },
      "additionalProperties": true
    },
    "editorNode": {
      "type": "object",
      "properties": {
        "selectable": {
          "type": "boolean"
        },
        "editable": {
          "type": "boolean"
        },
        "draggable": {
          "type": "boolean"
        },
        "droppable": {
          "type": "boolean"
        },
        "resizable": {
          "type": "boolean"
        },
        "deletable": {
          "type": "boolean"
        },
        "locked": {
          "type": "boolean"
        },
        "hiddenInLayers": {
          "type": "boolean"
        },
        "layoutBehavior": {
          "type": "string"
        },
        "allowedChildren": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedParents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resize": {
          "type": "object"
        },
        "snap": {
          "type": "object"
        },
        "constraints": {
          "type": "object"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "primitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "semanticKey": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "element",
            "text",
            "component-instance",
            "raw-html"
          ]
        },
        "type": {
          "type": "string"
        },
        "namespace": {
          "enum": [
            "html",
            "svg",
            "mathml"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Plain text content only. Do not embed HTML tags, escaped HTML, Markdown formatting, multiple semantic blocks, select options, or card markup here. Represent rich/semantic content with child node objects. Literal HTML examples belong only in code/pre-like content or explicit raw-html import nodes."
        },
        "html": {
          "type": "string",
          "description": "Raw HTML escape hatch for imports/advanced unsupported widgets. Normal AI website generation should use structured child nodes instead so every element remains editable."
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/primitive"
          }
        },
        "properties": {
          "type": "object"
        },
        "dataset": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/primitive"
          }
        },
        "assetRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "componentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "props": {
          "type": "object"
        },
        "slots": {
          "type": "object"
        },
        "overrides": {
          "type": "object"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "motion": {
          "$ref": "#/$defs/motion"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "interactionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "accessibility": {
          "$ref": "#/$defs/accessibility"
        },
        "editor": {
          "$ref": "#/$defs/editorNode"
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "$ref": "#/$defs/node"
              },
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "description": "Atomic child elements. AI-authoring should prefer complete recursive child node objects. Canonical normalized storage uses stable child IDs."
        },
        "extensions": {
          "type": "object"
        },
        "interactions": {
          "description": "AI-authoring convenience. Nexora extracts these into logic.interactions and binds targetNodeId to the owning node.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inlineInteraction"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/inlineInteraction"
              }
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "seo": {
          "type": "object"
        },
        "canvas": {
          "type": "object"
        },
        "globalStyles": {
          "type": "object"
        },
        "rootNodeId": {
          "type": "string"
        },
        "nodes": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          ]
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "variants": {
          "type": "object"
        },
        "slots": {
          "type": "object"
        },
        "rootNodeId": {
          "type": "string"
        },
        "nodes": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/node"
              }
            }
          ]
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "state.set",
            "state.toggle",
            "state.increment",
            "class.add",
            "class.remove",
            "class.toggle",
            "style.set",
            "attribute.set",
            "text.set",
            "visibility.show",
            "visibility.hide",
            "navigate",
            "url.open",
            "scroll.to",
            "focus",
            "form.submit",
            "form.reset",
            "media.play",
            "media.pause",
            "clipboard.write",
            "function.call",
            "event.emit"
          ]
        },
        "nodeId": {
          "type": "string"
        },
        "targetNodeId": {
          "type": "string"
        },
        "stateId": {
          "type": "string"
        },
        "functionId": {
          "type": "string"
        },
        "routeId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "value": {},
        "valueExpression": {
          "$ref": "#/$defs/expression"
        },
        "stateKey": {
          "type": "string"
        },
        "stateType": {
          "enum": [
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ]
        },
        "stateDefault": {},
        "initialValue": {},
        "state": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "enum": [
                "boolean",
                "number",
                "string",
                "array",
                "object"
              ]
            },
            "default": {}
          },
          "additionalProperties": true
        },
        "className": {
          "type": "string"
        },
        "property": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "arguments": {
          "type": "array"
        },
        "function": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "language": {
              "type": "string"
            },
            "parameters": {
              "type": "array"
            },
            "source": {
              "type": "string"
            },
            "code": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "interaction": {
      "type": "object",
      "required": [
        "id",
        "targetNodeId",
        "actions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "targetNodeId": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "preventDefault": {
              "type": "boolean"
            },
            "stopPropagation": {
              "type": "boolean"
            },
            "once": {
              "type": "boolean"
            },
            "passive": {
              "type": "boolean"
            },
            "capture": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "when": {
          "$ref": "#/$defs/expression"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "additionalProperties": true
    },
    "logic": {
      "type": "object",
      "properties": {
        "state": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/stateDefinition"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/stateDefinition"
              }
            }
          ]
        },
        "interactions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/interaction"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/interaction"
              }
            }
          ]
        },
        "functions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          ]
        },
        "computed": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "globalStyles": {
      "type": "object",
      "properties": {
        "rules": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/styleRule"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/styleRule"
              }
            }
          ]
        },
        "keyframes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "frames": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/cssDeclarations"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "fontFaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cssDeclarations"
          }
        },
        "customProperties": {
          "$ref": "#/$defs/cssDeclarations"
        },
        "atRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "css": {
                "type": "string"
              },
              "prelude": {
                "type": "string"
              },
              "declarations": {
                "$ref": "#/$defs/cssDeclarations"
              }
            },
            "additionalProperties": true
          }
        },
        "rawCss": {
          "type": "string",
          "description": "Complete standards-based CSS escape hatch. Preserved verbatim after structured global rules; node rules follow. Use for nested at-rules, cascade layers, property registrations and future CSS."
        }
      },
      "additionalProperties": true
    },
    "motionLibrary": {
      "type": "object",
      "properties": {
        "presets": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          ]
        },
        "keyframes": {
          "type": "object"
        },
        "effects": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/motionEffect"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/motionEffect"
              }
            }
          ]
        },
        "timelines": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/motionTimeline"
              }
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/motionTimeline"
              }
            }
          ]
        },
        "defaults": {
          "$ref": "#/$defs/motionTiming"
        },
        "reducedMotion": {
          "enum": [
            "skip",
            "final-frame",
            "allow"
          ]
        }
      },
      "additionalProperties": true,
      "description": "Reusable presets, effects and timelines. The compiler resolves these into CSS and Web Animations API behavior."
    },
    "scripts": {
      "type": "object",
      "properties": {
        "customBlocks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": true
              }
            ]
          }
        },
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "classic",
                  "module"
                ]
              },
              "defer": {
                "type": "boolean"
              },
              "integrity": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "compiler": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "html": {
          "type": "object"
        },
        "css": {
          "type": "object"
        },
        "javascript": {
          "type": "object"
        },
        "assets": {
          "type": "object"
        },
        "validation": {
          "type": "object"
        },
        "security": {
          "type": "object"
        },
        "sourceMaps": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "stateDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ]
        },
        "default": {},
        "value": {},
        "persistence": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "inlineInteraction": {
      "type": "object",
      "required": [
        "actions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "preventDefault": {
              "type": "boolean"
            },
            "stopPropagation": {
              "type": "boolean"
            },
            "once": {
              "type": "boolean"
            },
            "passive": {
              "type": "boolean"
            },
            "capture": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "when": {
          "$ref": "#/$defs/expression"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "additionalProperties": true
    },
    "motionTiming": {
      "type": "object",
      "properties": {
        "duration": {
          "type": [
            "string",
            "number"
          ],
          "description": "CSS time string (for example 650ms) or milliseconds."
        },
        "delay": {
          "type": [
            "string",
            "number"
          ]
        },
        "easing": {
          "type": "string"
        },
        "iterations": {
          "type": [
            "number",
            "string"
          ],
          "minimum": 0
        },
        "direction": {
          "enum": [
            "normal",
            "reverse",
            "alternate",
            "alternate-reverse"
          ]
        },
        "fill": {
          "enum": [
            "none",
            "forwards",
            "backwards",
            "both",
            "auto"
          ]
        },
        "playbackRate": {
          "type": "number"
        },
        "composite": {
          "enum": [
            "replace",
            "add",
            "accumulate"
          ]
        },
        "iterationComposite": {
          "enum": [
            "replace",
            "accumulate"
          ]
        }
      },
      "additionalProperties": true
    },
    "motionTrigger": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "load",
            "in-view",
            "hover",
            "focus",
            "click",
            "pointer-enter",
            "pointer-leave",
            "scroll",
            "view",
            "custom"
          ]
        },
        "event": {
          "type": "string",
          "description": "DOM/Nexora custom event name for custom triggers."
        },
        "once": {
          "type": "boolean"
        },
        "threshold": {
          "type": [
            "number",
            "array"
          ],
          "description": "Intersection threshold or thresholds."
        },
        "rootMargin": {
          "type": "string"
        },
        "sourceNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "axis": {
          "enum": [
            "block",
            "inline",
            "x",
            "y"
          ]
        },
        "start": {
          "type": [
            "string",
            "number"
          ]
        },
        "end": {
          "type": [
            "string",
            "number"
          ]
        },
        "scrub": {
          "type": [
            "boolean",
            "number"
          ]
        },
        "reverseOnExit": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "motionKeyframes": {
      "description": "WAAPI/CSS-compatible keyframes. Use an ordered array for per-frame offsets/easing/composite or an object for CSS percentage/from/to frames.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/cssDeclarations"
          }
        }
      ]
    },
    "motionEffect": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "targetNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "preset": {
          "type": "string"
        },
        "keyframes": {
          "$ref": "#/$defs/motionKeyframes"
        },
        "timing": {
          "$ref": "#/$defs/motionTiming"
        },
        "trigger": {
          "$ref": "#/$defs/motionTrigger"
        },
        "reducedMotion": {
          "enum": [
            "skip",
            "final-frame",
            "allow"
          ],
          "default": "skip"
        },
        "transformOrigin": {
          "type": "string"
        },
        "perspective": {
          "type": "string"
        },
        "willChange": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "description": "Structured target animation compiled to Web Animations API/runtime events. No opaque generated animation script is required.",
      "anyOf": [
        {
          "required": [
            "keyframes"
          ]
        },
        {
          "required": [
            "preset"
          ]
        }
      ]
    },
    "motionTimelineStep": {
      "type": "object",
      "required": [
        "effectId"
      ],
      "properties": {
        "effectId": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": [
            "number",
            "string"
          ],
          "description": "Timeline start in milliseconds or relative token such as <, >, +=120."
        },
        "delay": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "additionalProperties": true
    },
    "motionTimeline": {
      "type": "object",
      "required": [
        "id",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/motionTrigger"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/motionTimelineStep"
          }
        },
        "repeat": {
          "type": [
            "number",
            "string"
          ]
        },
        "yoyo": {
          "type": "boolean"
        },
        "reducedMotion": {
          "enum": [
            "skip",
            "final-frame",
            "allow"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
