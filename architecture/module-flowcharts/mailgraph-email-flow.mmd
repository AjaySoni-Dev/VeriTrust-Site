%%{init: {"theme":"base","themeVariables":{"primaryColor":"#e8f1ff","primaryBorderColor":"#3b82f6","lineColor":"#64748b","fontFamily":"Inter, Segoe UI, sans-serif"}}}%%
flowchart TD
  A(["Phishing workbench or trusted receiver"]) --> B{"Input mode"}
  B -- plain text --> C["POST /api/v2/phishing/analyze-text"]
  B -- EML ≤10 MiB --> D["POST /api/v2/phishing/analyze-eml"]
  B -- receiver object --> E["Internal receiver secret + organization-scoped object ref"]
  C & D & E --> F["Authenticate gateway action + enforce idempotency"]
  F --> G["Submit and claim gateway scan; compile active policy"]
  G --> H["Create email artifact"]
  H --> I{"Raw message available?"}
  I -- yes --> J["Store private EML with ≤24-hour retention job"]
  I -- no --> K["Metadata only"]
  J & K --> L["MailParser with size, depth, part, decode, and timeout caps"]
  L --> M["Normalized text/HTML, headers, attachments metadata, URLs"]
  M --> N{"Raw authentication evidence available?"}
  N -- yes --> O["mailauth SPF / DKIM / DMARC / ARC<br/>trusted Authentication-Results boundary"]
  N -- no --> P["Mark auth evidence unavailable"]
  M --> Q["Identity graph with tldts<br/>From, Reply-To, Return-Path, links, confusables"]
  M --> R["Received-chain infrastructure hops"]
  M --> S["Deterministic content observations"]
  M --> T["Parent body → MailGuard"]
  M --> U["Each child URL → Swift"]
  O & P & Q & R & S & T & U --> V["Persist email detail, evidence, graph,<br/>hops, and child artifacts"]
  V --> W["Correlate model + URL + deterministic + auth/identity evidence"]
  W --> X["Apply policy thresholds and required-route failure mode"]
  X --> Y(["gateway_decision + evidence + scan_id + request_id"])

  classDef decision fill:#fff8e6,stroke:#f59e0b;
  class B,I,N decision;
