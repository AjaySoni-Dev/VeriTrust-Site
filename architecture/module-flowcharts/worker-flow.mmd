%%{init: {"theme":"base","themeVariables":{"primaryColor":"#e8f1ff","primaryBorderColor":"#3b82f6","lineColor":"#64748b","fontFamily":"Inter, Segoe UI, sans-serif"}}}%%
flowchart TD
  A(["worker/index.js loop or signed serverless worker call"]) --> B["Reconcile expired uploads and unfinished scans"]
  B --> C{"Claim next lease-backed job"}
  C -- none --> D["Exit once-mode or poll again"]
  C -- gateway_media --> E["Heartbeat lease; download private object"]
  E --> F["Validate media and run deepfake image adapter"]
  F --> G["Persist route evidence; finalize when no work remains"]
  C -- webhook --> H["Resolve destination; enforce allowlist and public DNS"]
  H --> I["Decrypt AES-GCM secret; HMAC-sign timestamp + body"]
  I --> J["Deliver and persist attempt/outcome"]
  C -- retention --> K["Delete expired object and write receipt"]
  C -- platform job --> L["Privacy export/erase, purge, inference,<br/>telemetry rollup, or billing outbox"]
  G & J & K & L --> M{"Success?"}
  M -- yes --> N["Complete job and release lease"]
  M -- retryable --> O["Record error and schedule bounded retry"]
  M -- terminal --> P["Dead-letter / failed state with audit trail"]
  O --> C
  D --> C

  NOTE["Current deepfake gate prevents new media routes<br/>from being enqueued by gateway orchestration"]
  NOTE -.-> E

  classDef decision fill:#fff8e6,stroke:#f59e0b;
  classDef error fill:#fff1f2,stroke:#e11d48;
  classDef disabled fill:#f1f5f9,stroke:#94a3b8,stroke-dasharray:6 4;
  class C,M decision;
  class P error;
  class NOTE disabled;
