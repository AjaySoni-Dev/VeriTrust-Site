%%{init: {"theme":"base","themeVariables":{"primaryColor":"#e8f1ff","primaryBorderColor":"#3b82f6","lineColor":"#64748b","fontFamily":"Inter, Segoe UI, sans-serif"}}}%%
flowchart TD
  A(["Browser opens protected page"]) --> B["site.js calls consumeAuthCallback, then getSession"]
  B --> C{"URL fragment contains Supabase tokens?"}
  C -- yes --> D["Strip tokens from history immediately"] --> E["POST /api/auth-session?action=callback"]
  E --> F["Server validates access token with Supabase /auth/v1/user"]
  F --> G["Set HttpOnly access + refresh cookies"]
  C -- no --> H["GET /api/auth-session?action=session"]
  G --> H
  H --> I{"Access cookie valid?"}
  I -- yes --> J["Return sanitized user session"]
  I -- no, refresh present --> K["POST Supabase grant_type=refresh_token"]
  K --> L{"Refresh valid?"}
  L -- yes --> G
  L -- no --> M["Clear cookies"] --> N["Redirect /auth?redirect=current"]
  I -- no refresh --> N
  J --> O["Protected page shell loads"]
  O --> P["API request carries same-origin cookies"]
  P --> Q["getProfileContext verifies token and membership"]
  Q --> R{"Active organization membership?"}
  R -- yes --> S["Authorize by role, plan, scope, or action"]
  R -- no --> T["401/403 structured error"]
  S --> U["Run handler"]

  V(["Sign in or sign up form"]) --> W["POST auth-session with credentials"]
  W --> X["Database-backed network/account rate limits"]
  X --> Y{"Credentials / signup valid?"}
  Y -- yes --> G
  Y -- confirmation required --> Z["Show email confirmation state"]
  Y -- no --> T

  AA(["Learning preview route"]) --> AB{"middleware verifies<br/>veritrust_learning_access HMAC cookie?"}
  AB -- yes --> O
  AB -- no --> AC["307 /learning-access?next=…"]
  AC --> AD["POST /api/learning-access with access key"]
  AD --> AE{"Constant-time key check + rate limit"}
  AE -- valid --> AF["Set Strict 8-hour preview cookie"] --> O
  AE -- invalid --> T

  classDef decision fill:#fff8e6,stroke:#f59e0b;
  classDef error fill:#fff1f2,stroke:#e11d48;
  classDef data fill:#eefbf4,stroke:#22c55e;
  class C,I,L,R,Y,AB,AE decision;
  class T,N error;
  class G,AF data;
