%%{init: {"theme":"base","themeVariables":{"primaryColor":"#e8f1ff","primaryBorderColor":"#3b82f6","lineColor":"#64748b","fontFamily":"Inter, Segoe UI, sans-serif"}}}%%
flowchart TD
  A(["HTML page requested"]) --> B["Vercel clean URL / rewrite"]
  B --> C{"middleware route rule"}
  C -- "learning preview locked" --> D["307 to /learning-access"]
  C -- "disabled module route" --> E["404 or /detection redirect"]
  C -- allowed --> F["Load assets/js/core/config.js"]
  F --> G["Synchronous GET /api/client-config"]
  G --> H{"Config available?"}
  H -- no --> I["Fallback /config/modules.json"]
  H -- yes --> J["Apply module flags and endpoint map"]
  I --> J
  J --> K["Remove disabled navigation and page content"]
  K --> L["Load site.js and page-specific module"]
  L --> M{"Page access"}
  M -- public --> N["Render marketing, docs, auth, detection chooser"]
  M -- protected --> O["Resolve server-managed session"]
  O --> P{"Signed in?"}
  P -- no --> Q["Redirect /auth with safe redirect target"]
  P -- transient session error --> R["Render shell; protected APIs still enforce auth"]
  P -- yes --> S["Render protected module"]
  S --> T{"Selected journey"}
  T --> U["Dashboard / cases / account / billing"]
  T --> V["Phishing workbench / link check"]
  T --> W["Gateway submission / history / review"]
  T --> X["Learning / assessment / credentials"]
  T --> Y["Developer API keys / docs / CLI"]

  classDef decision fill:#fff8e6,stroke:#f59e0b;
  classDef error fill:#fff1f2,stroke:#e11d48;
  class C,H,M,P,T decision;
  class D,E,Q error;
