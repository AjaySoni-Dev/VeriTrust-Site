%%{init: {"theme":"base","themeVariables":{"primaryColor":"#e8f1ff","primaryTextColor":"#132238","primaryBorderColor":"#3b82f6","lineColor":"#64748b","secondaryColor":"#eefbf4","tertiaryColor":"#fff8e6","fontFamily":"Inter, Segoe UI, sans-serif"},"flowchart":{"curve":"basis","nodeSpacing":28,"rankSpacing":46}}}%%
flowchart LR
  START(["User, developer, receiver,<br/>webhook, or worker event"])

  subgraph EDGE["1. Delivery, configuration, and gates"]
    VERCEL["Vercel static hosting + 7 serverless aggregators<br/>vercel.json / api/*.js"]
    MW{"middleware.ts<br/>route allowed?"}
    CFG["Runtime module config<br/>phishing ON · link ON · gateway ON<br/>deepfake OFF"]
    CSP["Security headers, CSP, HSTS,<br/>clean URLs, API rewrites"]
    NOTFOUND["404 / redirect to /detection"]
  end

  subgraph BROWSER["2. Browser application — static multi-page UI"]
    BOOT["Page boot<br/>config.js → site.js → page module"]
    CLIENTCFG["GET /api/client-config<br/>fallback /config/modules.json"]
    NAV{"Public or protected page?"}
    PUBLIC["Public journey<br/>home · auth · detection · docs<br/>developers · model performance"]
    SESSION["getSession / callback consumption<br/>supabase-client.js"]
    SIGNED{"Authenticated?"}
    LOGIN["/auth?redirect=…"]
    APP["Protected product UI<br/>dashboard · account · billing · cases<br/>API access · gateway · learning"]
    PHISHUI["Phishing workbench<br/>plain text · EML · receiver guidance"]
    LINKUI["Link intelligence form"]
    GWUI["Gateway form<br/>text · URLs · media upload"]
    LEARNUI["Learning catalog, lesson,<br/>assessment, certificate, admin"]
  end

  subgraph AUTH["3. Authentication and authorization"]
    AUTHAPI["/api/auth-session<br/>signin · signup · session · callback<br/>password · logout"]
    SUPAAUTH["Supabase Auth<br/>password, recovery, token refresh"]
    COOKIE["HttpOnly cookies<br/>veritrust_access + veritrust_refresh"]
    PROFILE["getProfileContext<br/>profile · organization · membership<br/>role · plan"]
    PREVIEW["Learning preview gate<br/>HMAC cookie, 8-hour TTL"]
    APIKEY["Developer API key auth<br/>vtg_* → SHA-256 lookup<br/>scope + entitlement + quota"]
    GWAUTH["Gateway action auth<br/>browser cookie or integration API key"]
    DENY["401 / 403 / 404 / 429<br/>structured error + request ID"]
  end

  subgraph SERVER["4. Serverless API surface"]
    ACCOUNT["api/account.js<br/>auth, account, cases, API keys"]
    BILLING["api/billing.js<br/>checkout, portal, subscription, webhook"]
    DETECT["api/detection.js<br/>browser phishing, link, deepfake"]
    V1["api/v1.js<br/>developer scans + usage"]
    GATEWAY["api/gateway.js<br/>scans, uploads, reports, policy,<br/>webhooks, review, operations"]
    LEARNING["api/learning.js<br/>catalog, progress, assessment,<br/>certificate, admin"]
    SYSTEM["api/system.js<br/>client config, health, cards,<br/>sitemap, learning-access"]
  end

  subgraph PIPELINES["5. Detection and orchestration pipelines"]
    SIMPLEP["Simple phishing<br/>validate → persist lifecycle → MailGuard or Cortex"]
    MAILGRAPH["MailGraph v2<br/>parse EML → auth → identity graph → hops<br/>→ MailGuard + child URL scans → correlate"]
    SIMPLEL["Link intelligence<br/>normalize URL → deterministic rules<br/>→ Swift model → weighted score"]
    DEEP["Deepfake image pipeline<br/>Pixel / Prism classifier + fallback<br/>IMPLEMENTED BUT DISABLED"]
    ORCH["Gateway orchestrator<br/>idempotency → policy → artifacts → routes<br/>→ evidence → correlation → decision"]
    MEDIA["Media routing<br/>omitted while deepfake module is OFF"]
    DECISION["Policy decision<br/>allow · warn · manual review<br/>quarantine · block"]
  end

  subgraph EXTERNAL["6. External services"]
    HF["Hugging Face Router<br/>pinned qualified model contracts"]
    STRIPE["Stripe<br/>Checkout · Portal · signed webhook"]
    CROP["Optional external face crop service<br/>deepfake path only"]
    MAILAUTH["mailauth + mailparser + tldts<br/>SPF/DKIM/DMARC/ARC, MIME, domains"]
    WEBHOOK["Customer webhook destinations<br/>allowlist + DNS safety + HMAC"]
  end

  subgraph DATA["7. Supabase data and private objects"]
    DB[("Postgres / PostgREST / RPC<br/>identity, scans, evidence, cases,<br/>usage, billing, gateway, email, learning")]
    STORE[("Supabase Storage<br/>avatars · private gateway-uploads")]
    IDEM[("Idempotency, rate limits,<br/>leases, jobs, outbox")]
  end

  subgraph ASYNC["8. Durable asynchronous execution"]
    QUEUE["Queue pending work<br/>gateway_media · webhooks · retention<br/>privacy · inference · telemetry"]
    WORKER["worker/index.js or signed worker endpoint<br/>claim → lease → heartbeat → retry"]
    FINALIZE["Persist evidence and finalize<br/>scan / delivery / retention receipt"]
  end

  START --> VERCEL
  VERCEL --> CSP --> MW
  CFG --> MW
  MW -- "disabled or protected preview" --> NOTFOUND
  MW -- "allowed" --> BOOT
  BOOT --> CLIENTCFG --> CFG
  BOOT --> NAV
  NAV -- "public" --> PUBLIC
  NAV -- "protected" --> SESSION --> SIGNED
  SIGNED -- "no" --> LOGIN --> AUTHAPI
  SIGNED -- "yes" --> APP
  APP --> PHISHUI & LINKUI & GWUI & LEARNUI

  AUTHAPI --> SUPAAUTH --> COOKIE --> SESSION
  ACCOUNT & BILLING & DETECT & LEARNING --> PROFILE
  LEARNUI --> PREVIEW
  V1 --> APIKEY
  GATEWAY --> GWAUTH
  PROFILE & PREVIEW & APIKEY & GWAUTH -- "invalid / insufficient / limited" --> DENY

  PUBLIC --> SYSTEM
  APP --> ACCOUNT & BILLING & LEARNING
  PHISHUI --> GATEWAY
  LINKUI --> DETECT
  GWUI --> GATEWAY
  CLIENTCFG --> SYSTEM
  APIKEY --> V1
  STRIPE --> BILLING

  DETECT --> SIMPLEP & SIMPLEL & DEEP
  V1 --> SIMPLEP & SIMPLEL & DEEP
  GATEWAY --> MAILGRAPH & ORCH
  SIMPLEP --> HF
  SIMPLEL --> HF
  DEEP --> HF & CROP
  MAILGRAPH --> MAILAUTH & HF
  MAILGRAPH --> ORCH
  ORCH --> SIMPLEP & SIMPLEL
  ORCH --> MEDIA
  MEDIA -. "gate OFF: no image/audio/video route" .-> DECISION
  SIMPLEP & SIMPLEL & MAILGRAPH & DEEP --> DECISION

  PROFILE & SIMPLEP & SIMPLEL & MAILGRAPH & ORCH & LEARNING & BILLING --> DB
  ORCH & MAILGRAPH --> STORE
  ACCOUNT & BILLING & GATEWAY --> IDEM
  BILLING --> STRIPE
  ORCH --> QUEUE
  QUEUE --> IDEM --> WORKER
  WORKER --> HF & STORE & WEBHOOK
  WORKER --> FINALIZE --> DB
  DECISION --> DB
  DECISION --> APP
  DECISION --> WEBHOOK

  classDef entry fill:#172554,color:#ffffff,stroke:#172554;
  classDef active fill:#e8f1ff,color:#132238,stroke:#3b82f6;
  classDef data fill:#eefbf4,color:#123524,stroke:#22c55e;
  classDef decision fill:#fff8e6,color:#3d2d05,stroke:#f59e0b;
  classDef disabled fill:#f1f5f9,color:#475569,stroke:#94a3b8,stroke-dasharray:6 4;
  classDef error fill:#fff1f2,color:#4c0519,stroke:#e11d48;
  class START entry;
  class VERCEL,BOOT,CLIENTCFG,PUBLIC,APP,PHISHUI,LINKUI,GWUI,LEARNUI,AUTHAPI,SUPAAUTH,COOKIE,PROFILE,PREVIEW,APIKEY,GWAUTH,ACCOUNT,BILLING,DETECT,V1,GATEWAY,LEARNING,SYSTEM,SIMPLEP,MAILGRAPH,SIMPLEL,ORCH,HF,STRIPE,CROP,MAILAUTH,WEBHOOK,QUEUE,WORKER,FINALIZE active;
  class CFG,NAV,SIGNED,MW,DECISION decision;
  class DB,STORE,IDEM data;
  class DEEP,MEDIA disabled;
  class NOTFOUND,DENY error;
